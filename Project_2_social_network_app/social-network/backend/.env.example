# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/pulse_social
# Or MongoDB Atlas (cloud, free tier):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pulse_social

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string_before_deploying
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=pulse_token

# Frontend URL (for CORS + socket.io)
CLIENT_URL=http://localhost:5173

# File upload limits (in bytes) - 5MB default
MAX_FILE_SIZE=5242880
