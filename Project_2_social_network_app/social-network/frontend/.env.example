# In local development, the frontend talks to the backend via the Vite dev
# server proxy configured in vite.config.js — no env vars are needed.
#
# If you deploy the frontend and backend on different domains in production,
# uncomment and set this so the API/socket client points at the right host,
# then update src/services/api.js and src/services/socket.js to use it.

# VITE_API_URL=https://your-backend-domain.com
