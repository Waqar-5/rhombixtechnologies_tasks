# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
# mongodb+srv://root:root12@cluster0.kjhkctd.mongodb.net/nexus_jobs
# MONGO_URI = mongodb+srv://root:root12@cluster0.kjhkctd.mongodb.net/nexus_jobs
MONGO_URI=mongodb+srv://root:roots12@cluster0.kjhkctd.mongodb.net/nexus_jobs
# MONGO_URI=mongodb://127.0.0.1:27017/

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Reset password token expiry (minutes)
RESET_TOKEN_EXPIRE_MINUTES=30

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
