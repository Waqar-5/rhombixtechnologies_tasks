# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blogsphere?retryWrites=true&w=majority

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES=30d

# Cookie expiry in days (should match refresh token lifetime)
JWT_COOKIE_EXPIRES_DAYS=30

# ==========================================
# EMAIL VERIFICATION / PASSWORD RESET TOKENS
# ==========================================
EMAIL_VERIFICATION_EXPIRES_MIN=1440
PASSWORD_RESET_EXPIRES_MIN=15

# ==========================================
# LOCAL IMAGE STORAGE
# ==========================================
# Uploaded images (avatars, cover images, category images) are saved to
# backend/uploads/ and served at {SERVER_URL}/uploads/... — no external
# image host required. Only set SERVER_URL if this backend's public URL
# differs from http://localhost:<PORT> (e.g. in production).
# SERVER_URL=https://your-backend-domain.com

# ==========================================
# NODEMAILER (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=BlogSphere <no-reply@blogsphere.com>

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ==========================================
# SEED SCRIPT (npm run seed) — local dev only
# ==========================================
SEED_ADMIN_EMAIL=admin@blogsphere.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=BlogSphere Admin
