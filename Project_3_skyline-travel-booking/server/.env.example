# Copy this file to .env and fill in your own values.

PORT=5000

# Set to "true" to run entirely on local JSON-file storage (no MongoDB needed).
# Set to "false" (and provide MONGO_URI) to use a real MongoDB database.
USE_MOCK=true

# Only needed when USE_MOCK=false
MONGO_URI=mongodb://127.0.0.1:27017/skyline-travel

# Any long random string
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: enables real payment confirmation via Stripe test mode.
# Leave blank to use the built-in mock payment flow.
STRIPE_SECRET_KEY=

# Optional: enables live flight search via the Amadeus Self-Service API
# (free tier, no prerequisites: https://developers.amadeus.com/register).
# Leave both blank to use the built-in mock flight catalog. When set,
# /api/flights?originCode=XXX&destinationId=dst_xxx will try a live
# search first and automatically fall back to mock data if the live
# call fails or returns nothing for that route.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
